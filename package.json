{
  "name": "express-bookmark-api",
  "version": "1.0.0",
  "description": "A REST API for managing bookmarks with JWT auth, Prisma, MySQL, and role-based access control.",
  "main": "src/server.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ken-paps/express-bookmark-api.git"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:admin": "node prisma/seed.js"
  },
  "keywords": [
    "express",
    "prisma",
    "mysql",
    "jwt",
    "authentication",
    "rest-api",
    "bookmarks"
  ],
  "author": "Ken Paps",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "mariadb": "^3.5.4",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1"
  }
}
